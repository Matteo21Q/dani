correct[[n.t]]<-ifelse((inherits(out1B, "try-error"))&&(grepl("all(rates > 0) is not TRUE", out1B[1], fixed=T  )),1,0)
names(correct)[[n.t]]<-"out1B"
n.t=n.t+1
